// SlotBack data model.
// Conventions: timestamps are stored in UTC; each Location keeps its IANA timezone
// for display and scheduling. Money is stored as integer paise (INR minor units).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity and tenancy ────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  STAFF
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  name        String
  /// Bumped to sign the user out of every browser: web sessions carry the version they were issued with.
  sessionVersion Int          @default(0) @map("session_version")
  createdAt   DateTime        @default(now()) @map("created_at")
  memberships Membership[]
  devices     DeviceSession[]

  @@map("users")
}

model Organization {
  id          String          @id @default(cuid())
  name        String
  plan        String          @default("pilot")
  isDemo      Boolean         @default(false) @map("is_demo")
  /// Business type chosen at sign-up, e.g. "salon"; drives suggested services during onboarding.
  vertical    String?
  city        String?
  /// Set when the owner finishes the setup wizard. Null sends owners to /onboarding.
  onboardedAt DateTime?       @map("onboarded_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  memberships Membership[]
  invites     Invite[]
  devices     DeviceSession[]
  locations   Location[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  role           Role         @default(STAFF)
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

/// A phone signed in to the staff app. It starts as a pairing code shown as a QR in a signed-in
/// browser (10 minutes, one use), then becomes a long-lived device token. Only hashes are stored.
model DeviceSession {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  locationId     String       @map("location_id")
  pairHash       String?      @unique @map("pair_hash")
  pairExpiresAt  DateTime?    @map("pair_expires_at")
  tokenHash      String?      @unique @map("token_hash")
  deviceName     String?      @map("device_name")
  pairedAt       DateTime?    @map("paired_at")
  lastUsedAt     DateTime?    @map("last_used_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("device_sessions")
}

/// A pending invitation to join a business. The link carries a random token; only its hash
/// is stored. Accepting needs a sign-in link sent to this exact email, so a forwarded link is useless.
model Invite {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  email          String
  name           String
  role           Role         @default(STAFF)
  tokenHash      String       @unique @map("token_hash")
  invitedById    String       @map("invited_by_id")
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@map("invites")
}

model Location {
  id              String             @id @default(cuid())
  organizationId  String             @map("organization_id")
  name            String
  address         String?
  phone           String?
  timezone        String             @default("Asia/Kolkata")
  currency        String             @default("INR")
  /// Weekly opening hours: { "0": [{ "open": "10:00", "close": "20:00" }], ... } keyed by weekday (0 = Sunday).
  businessHours   Json               @map("business_hours")
  /// Minimum notice before a slot starts for it to be offered.
  minLeadMinutes  Int                @default(60) @map("min_lead_minutes")
  /// How long an offer link stays claimable.
  offerTtlMinutes Int                @default(30) @map("offer_ttl_minutes")
  /// Customers contacted per campaign launch.
  offerBatchSize  Int                @default(5) @map("offer_batch_size")
  /// No customer messages between these local times ("HH:mm").
  quietHoursStart String             @default("21:00") @map("quiet_hours_start")
  quietHoursEnd   String             @default("09:00") @map("quiet_hours_end")
  /// When a round closes unclaimed, offer the slot to the next people in line without staff action.
  autoNextRound   Boolean            @default(true) @map("auto_next_round")
  /// Most rounds a campaign sends, counting the first one staff start.
  maxRounds       Int                @default(3) @map("max_rounds")
  /// Public code in the waitlist self-join link (/join/<code>). Created when first shared; rotating it retires old QR posters.
  joinCode        String?            @unique @map("join_code")
  createdAt       DateTime           @default(now()) @map("created_at")
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services        Service[]
  resources       Resource[]
  customers       Customer[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  campaigns       RecoveryCampaign[]
  outboxMessages  OutboxMessage[]

  @@index([organizationId])
  @@map("locations")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Service {
  id              String             @id @default(cuid())
  locationId      String             @map("location_id")
  name            String
  durationMinutes Int                @map("duration_minutes")
  /// Owner-entered value estimate, in paise.
  pricePaise      Int                @map("price_paise")
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @map("created_at")
  location        Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resources       Resource[]         @relation("ResourceServices")
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  campaigns       RecoveryCampaign[]

  @@index([locationId])
  @@map("services")
}

enum ResourceKind {
  STAFF
  ROOM
  EQUIPMENT
}

/// A bookable staff member, chair or room.
model Resource {
  id           String             @id @default(cuid())
  locationId   String             @map("location_id")
  name         String
  kind         ResourceKind       @default(STAFF)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  services     Service[]          @relation("ResourceServices")
  appointments Appointment[]
  campaigns    RecoveryCampaign[]

  @@index([locationId])
  @@map("resources")
}

// ─── Customers and consent ───────────────────────────────────────────────────

enum Channel {
  WHATSAPP
  SMS
  EMAIL
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model Customer {
  id               String           @id @default(cuid())
  locationId       String           @map("location_id")
  name             String
  phone            String?
  email            String?
  preferredChannel Channel          @default(WHATSAPP) @map("preferred_channel")
  createdAt        DateTime         @default(now()) @map("created_at")
  deletedAt        DateTime?        @map("deleted_at")
  location         Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  consents         ChannelConsent[]
  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  offers           Offer[]

  @@index([locationId])
  @@map("customers")
}

/// Consent is channel-specific and timestamped. A REVOKED row suppresses all outreach on that channel.
model ChannelConsent {
  id         String        @id @default(cuid())
  customerId String        @map("customer_id")
  channel    Channel
  status     ConsentStatus
  source     String
  updatedAt  DateTime      @updatedAt @map("updated_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, channel])
  @@map("channel_consents")
}

// ─── Appointments ────────────────────────────────────────────────────────────

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  DIRECT
  RECOVERY
}

/// Overlap protection: a Postgres exclusion constraint (see migrations) rejects two
/// non-cancelled appointments for the same resource with intersecting time ranges.
model Appointment {
  id               String            @id @default(cuid())
  locationId       String            @map("location_id")
  customerId       String?           @map("customer_id")
  serviceId        String            @map("service_id")
  resourceId       String            @map("resource_id")
  startAt          DateTime          @map("start_at")
  endAt            DateTime          @map("end_at")
  status           AppointmentStatus @default(BOOKED)
  source           AppointmentSource @default(DIRECT)
  valuePaise       Int               @map("value_paise")
  cancelReason     String?           @map("cancel_reason")
  cancelledAt      DateTime?         @map("cancelled_at")
  completedAt      DateTime?         @map("completed_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  location         Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  service          Service           @relation(fields: [serviceId], references: [id])
  resource         Resource          @relation(fields: [resourceId], references: [id])
  /// The recovery campaign opened when this appointment was cancelled.
  recoveryCampaign RecoveryCampaign? @relation("CampaignOrigin")
  /// Set when this appointment was booked by claiming a recovery offer.
  claim            Claim?

  @@index([locationId, startAt])
  @@index([resourceId, startAt])
  @@map("appointments")
}

// ─── Waitlist ────────────────────────────────────────────────────────────────

enum WaitlistStatus {
  ACTIVE
  FULFILLED
  REMOVED
}

model WaitlistEntry {
  id             String         @id @default(cuid())
  locationId     String         @map("location_id")
  customerId     String         @map("customer_id")
  /// Null means "any service".
  serviceId      String?        @map("service_id")
  /// Acceptable weekdays, 0 = Sunday. Empty means any day.
  preferredDays  Int[]          @map("preferred_days")
  /// Acceptable local time window, in minutes after midnight.
  earliestMinute Int            @default(0) @map("earliest_minute")
  latestMinute   Int            @default(1440) @map("latest_minute")
  status         WaitlistStatus @default(ACTIVE)
  notes          String?
  expiresAt      DateTime?      @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  offers         Offer[]

  @@index([locationId, status])
  @@map("waitlist_entries")
}

// ─── Recovery ────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLAIMED
  EXPIRED
  CANCELLED
}

/// One campaign per cancelled appointment. Snapshot fields describe the open slot.
model RecoveryCampaign {
  id            String         @id @default(cuid())
  locationId    String         @map("location_id")
  appointmentId String         @unique @map("appointment_id")
  serviceId     String         @map("service_id")
  resourceId    String         @map("resource_id")
  startAt       DateTime       @map("start_at")
  endAt         DateTime       @map("end_at")
  valuePaise    Int            @map("value_paise")
  status        CampaignStatus @default(DRAFT)
  roundsSent    Int            @default(0) @map("rounds_sent")
  /// Eligibility rules in force at launch, for auditability.
  rulesSnapshot Json           @map("rules_snapshot")
  expiresAt     DateTime?      @map("expires_at")
  launchedAt    DateTime?      @map("launched_at")
  claimedAt     DateTime?      @map("claimed_at")
  createdById   String?        @map("created_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointment   Appointment    @relation("CampaignOrigin", fields: [appointmentId], references: [id])
  service       Service        @relation(fields: [serviceId], references: [id])
  resource      Resource       @relation(fields: [resourceId], references: [id])
  offers        Offer[]
  claim         Claim?

  @@index([locationId, status])
  @@map("recovery_campaigns")
}

enum OfferStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  OPENED
  CLAIMED
  LOST
  EXPIRED
  SUPPRESSED
}

/// A single customer's invitation to claim a campaign's slot.
model Offer {
  id              String           @id @default(cuid())
  campaignId      String           @map("campaign_id")
  customerId      String           @map("customer_id")
  waitlistEntryId String?          @map("waitlist_entry_id")
  channel         Channel
  rank            Int
  /// SHA-256 of the claim token. The raw token only ever exists in the message link.
  tokenHash       String           @unique @map("token_hash")
  status          OfferStatus      @default(QUEUED)
  expiresAt       DateTime         @map("expires_at")
  sentAt          DateTime?        @map("sent_at")
  openedAt        DateTime?        @map("opened_at")
  respondedAt     DateTime?        @map("responded_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  campaign        RecoveryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  waitlistEntry   WaitlistEntry?   @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  claim           Claim?
  messages        OutboxMessage[]

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@map("offers")
}

/// The winning claim. The unique campaign_id is the database-level guarantee
/// that a slot can be claimed by at most one customer.
model Claim {
  id            String           @id @default(cuid())
  campaignId    String           @unique @map("campaign_id")
  offerId       String           @unique @map("offer_id")
  appointmentId String           @unique @map("appointment_id")
  claimedAt     DateTime         @default(now()) @map("claimed_at")
  campaign      RecoveryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  offer         Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  appointment   Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("claims")
}

// ─── Messaging ───────────────────────────────────────────────────────────────

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

/// Durable outbox. Rows are written in the same transaction as the state change that
/// causes them, then delivered by a worker through the configured provider adapter.
model OutboxMessage {
  id                String        @id @default(cuid())
  locationId        String        @map("location_id")
  offerId           String?       @map("offer_id")
  channel           Channel
  provider          String
  toAddress         String        @map("to_address")
  body              String
  /// WhatsApp template name and variables. Cleared after sending, because it holds the claim token.
  template          Json?
  status            MessageStatus @default(QUEUED)
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now()) @map("next_attempt_at")
  providerMessageId String?       @map("provider_message_id")
  errorCode         String?       @map("error_code")
  idempotencyKey    String        @unique @map("idempotency_key")
  sentAt            DateTime?     @map("sent_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  location          Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  offer             Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

enum ActorType {
  USER
  CUSTOMER
  SYSTEM
}

/// Minimised audit trail: no message bodies, tokens or contact details in metadata.
model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  actorType      ActorType    @map("actor_type")
  actorId        String?      @map("actor_id")
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  action         String
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ─── Marketing ───────────────────────────────────────────────────────────────

model Lead {
  id        String   @id @default(cuid())
  name      String
  business  String
  phone     String?
  email     String?
  city      String?
  vertical  String?
  message   String?
  /// HMAC of the submitter's IP, only for rate limiting. The raw IP is never stored.
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ipHash, createdAt])
  @@map("leads")
}

/// One row per rate-limited public action (keyed by purpose + hashed IP). Old rows can be deleted freely.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}
