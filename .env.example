# Copy to .env for local development. Never commit real values.

# Postgres connection string. Locally: any Postgres 15+.
# Production: Supabase pooled connection string (Transaction pooler, port 6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slotback"

# Direct (non-pooled) connection used only by `prisma migrate`. Supabase: Session pooler or direct, port 5432.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/slotback"

# Secret used to sign session cookies and hash claim tokens. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Public base URL used in claim links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enables the one-click demo login. Set to "false" to hide it.
DEMO_MODE="true"

# Message provider for real workspaces. Only "demo" (simulated, sends nothing) exists today.
MESSAGE_PROVIDER="demo"

# Secret the scheduled job sends to /api/cron/tick. Generate with: openssl rand -base64 24
CRON_SECRET=""
